# =============================================================================
# Portfolio Automation — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# --- GitHub ---
# Buat token di: Settings > Developer settings > Personal access tokens > Fine-grained tokens
# Minimal scope: "Public repositories" (read-only)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_USERNAME=Fauzan-A25

# --- Google Sheets ---
# 1. Buka https://console.cloud.google.com
# 2. Buat project baru atau pilih existing
# 3. Enable "Google Sheets API"
# 4. Buat Service Account → Download JSON key → simpan di ./secrets/
# 5. Share spreadsheet-mu dengan service account email (client_email dari JSON)
GOOGLE_CREDENTIALS_PATH=./secrets/google-service-account.json
SPREADSHEET_ID=1SjfncmLV-Xarqir6ur0G3YvJD0m5RogjBxOkTSoEgdU
GITHUB_REPOS_SHEET_NAME=GitHubRepos

# --- LinkedIn (optional) ---
# Integrasi LinkedIn terbatas — lihat docs/linkedin-strategy.md
LINKEDIN_USERNAME=fauzanahsanudin
LINKEDIN_ENABLED=false

# --- Sync Config ---
LOG_LEVEL=INFO
SYNC_INTERVAL_HOURS=6

# --- AI (pilih salah satu) ---
# Gemini (RECOMMENDED - lebih murah)
GEMINI_API_KEY=AIzaSy...your_gemini_key_here
# DeepSeek (fallback jika Gemini tidak tersedia)
DEEPSEEK_API_KEY=sk-your_deepseek_key_here
